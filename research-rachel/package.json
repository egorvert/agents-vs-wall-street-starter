{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "dev:web": "npm run dev --workspace @hackathon-starter/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/python.mjs -m pytest -c apps/api/pyproject.toml",
    "test:web": "npm run test --workspace @hackathon-starter/web",
    "lint": "npm run lint:api && npm run lint:web && npm run typecheck",
    "lint:api": "node scripts/python.mjs -m ruff check apps/api",
    "lint:web": "oxlint --deny-warnings apps/web",
    "format": "node scripts/python.mjs -m ruff format apps/api && oxfmt --write .",
    "format:check": "node scripts/python.mjs -m ruff format --check apps/api && oxfmt --check .",
    "typecheck": "npm run typecheck --workspace @hackathon-starter/web",
    "build": "npm run build --workspace @hackathon-starter/web",
    "doctor": "react-doctor apps/web --blocking warning",
    "doctor:staged": "react-doctor apps/web --staged --blocking warning",
    "check": "npm run format:check && npm run lint && npm run doctor && npm test && npm run build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "jsdom": "29.1.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "react-doctor": "0.9.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}
