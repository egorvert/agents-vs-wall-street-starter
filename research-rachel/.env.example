# Optional: the API and demo persistence work without an OpenAI key.
OPENAI_API_KEY=

# Browser-facing FastAPI base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Leave blank to use apps/api/data/hackathon.db.
# A future PostgresRepository can use a postgresql:// URL here.
DATABASE_URL=

# Comma-separated origins allowed to call FastAPI from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
